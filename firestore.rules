// Firestore 보안 규칙
// Firebase Console > Firestore > 규칙 탭에 붙여넣으세요

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null &&
        (request.auth.uid == userId ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // 쿠폰
    match /coupons/{couponId} {
      allow read: if true;
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['business', 'master'];
      allow update: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master' ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']));
      allow delete: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master');
    }

    // 쿠폰 사용 내역
    match /couponClaims/{claimId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master');
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        (resource.data.userId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow delete: if false;
    }

    // 매장
    match /stores/{storeId} {
      allow read: if true;
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['business', 'master'];
      allow update: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master');
      allow delete: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master');
    }
  }
}
