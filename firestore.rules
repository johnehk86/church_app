// Firestore 보안 규칙
// Firebase Console > Firestore > 규칙 탭에 붙여넣으세요

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자
    match /users/{userId} {
      allow read: if request.auth != null;
      // 본인 가입 시 관리자 역할로는 생성 불가, 본인은 역할 변경 불가 (역할 변경은 관리자만)
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.role in ['member', 'business'];
      allow update: if request.auth != null &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master' ||
         (request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.get('removed', false) == resource.data.get('removed', false)));
      // 강제 탈퇴된 회원은 문서를 지우고 재가입하는 우회 불가
      allow delete: if request.auth != null && request.auth.uid == userId &&
        resource.data.get('removed', false) == false;
    }

    // 쿠폰
    match /coupons/{couponId} {
      allow read: if true;
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['business', 'master'];
      allow update: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master' ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']));
      allow delete: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master');
    }

    // 쿠폰 사용 내역
    match /couponClaims/{claimId} {
      allow read: if request.auth != null &&
        (resource == null ||
         resource.data.userId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master');
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('removed', false) == false;
      // 성도 본인은 사용 처리·숨김만 가능 (사용완료를 미사용으로 되돌려 재사용하는 것 차단)
      allow update: if request.auth != null &&
        ((resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isUsed', 'usedAt', 'hidden']) &&
          (resource.data.isUsed == false || request.resource.data.isUsed == true)) ||
         resource.data.ownerId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master');
      allow delete: if false;
    }

    // 매장
    match /stores/{storeId} {
      allow read: if true;
      // 사업자는 승인 대기(pending)로만 생성 가능, 상태 변경은 관리자만
      allow create: if request.auth != null &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master' ||
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'business' &&
          request.resource.data.status == 'pending'));
      allow update: if request.auth != null &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master' ||
         (resource.data.ownerId == request.auth.uid &&
          request.resource.data.get('status', null) == resource.data.get('status', null)));
      allow delete: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master');
    }
  }
}
